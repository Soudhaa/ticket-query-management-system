@model List<Ticket>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <div class="container-fluid">
        <h1><i class="fas fa-tachometer-alt"></i> Admin Dashboard</h1>
        <p class="text-muted">System overview and management</p>
    </div>
</div>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="stat-card">
                <h3>@ViewBag.TotalTickets</h3>
                <p>Total Tickets</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card">
                <h3 style="color: #e74c3c;">@ViewBag.OpenTickets</h3>
                <p>Open Tickets</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card">
                <h3 style="color: #27ae60;">@ViewBag.ResolvedTickets</h3>
                <p>Resolved</p>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="stat-card">
                <h3 style="color: #3498db;">@ViewBag.TotalUsers</h3>
                <p>Total Users</p>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-list"></i> Recent Tickets</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th>Ticket</th>
                                    <th>Title</th>
                                    <th>Client</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Assigned To</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ticket in Model)
                                {
                                    <tr>
                                        <td><strong>@ticket.TicketNumber</strong></td>
                                        <td>@ticket.Title</td>
                                        <td>@ticket.Client.FirstName @ticket.Client.LastName</td>
                                        <td><span class="status-badge status-@ticket.Status.ToString().ToLower()">@ticket.Status</span></td>
                                        <td><span class="priority-@ticket.Priority.Level.ToString().ToLower()">@ticket.Priority.Description</span></td>
                                        <td>@(ticket.AssignedTo?.FirstName ?? "Unassigned")</td>
                                        <td>
                                            <a href="/Tickets/Details/@ticket.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="fas fa-cog"></i> Management</h5>
                </div>
                <div class="card-body">
                    <a href="/Admin/ManageUsers" class="btn btn-outline-primary w-100 mb-2">
                        <i class="fas fa-users"></i> Manage Users
                    </a>
                    <a href="/Admin/ManageTickets" class="btn btn-outline-primary w-100 mb-2">
                        <i class="fas fa-ticket-alt"></i> Manage Tickets
                    </a>
                    <a href="/Admin/Categories" class="btn btn-outline-primary w-100 mb-2">
                        <i class="fas fa-list"></i> Categories
                    </a>
                    <a href="/Admin/Reports" class="btn btn-outline-primary w-100">
                        <i class="fas fa-chart-bar"></i> Reports
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-bell"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <p><small>System is running smoothly. All systems operational.</small></p>
                    <p><small>Last backup: Today at 2:00 AM</small></p>
                </div>
            </div>
        </div>
    </div>
</div>